# ==========================================
# Root Workspace Git Ignore Rules
# ==========================================

# Environment & Credentials
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
*.local
*.pem
*.key
credentials.json
serviceAccountKey.json

# Server uploads
server/uploads/*
!server/uploads/.gitkeep

# Node modules
node_modules/

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Builds & logs
dist/
build/
*.log

