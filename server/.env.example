# ==========================================
# MiniLedger - Environment Variables Template
# Copy this file to .env and provide your values
# ==========================================

PORT=5000
MONGODB_URI=mongodb://localhost:27017/miniledger
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miniledger
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Razorpay Payment Gateway (Test credentials)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
